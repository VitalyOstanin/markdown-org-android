# The pinned toolchain versions, written down once.
#
# Read by the scripts in this directory, by app/build.gradle.kts and by the CI
# workflow; the Containerfiles take them as build arguments rather than
# repeating them. Shell syntax on purpose — `source` here, a two-line parser
# in Gradle, `>> $GITHUB_ENV` in the workflow.
#
# A version that appears in exactly one place is not here: minSdk and
# targetSdk live in app/build.gradle.kts, the library versions in
# gradle/libs.versions.toml.

# Compiling against 37 while targeting 36: androidx.lifecycle 2.11 refuses to
# be consumed by a project on an older compileSdk.
ANDROID_COMPILE_SDK=37
ANDROID_PLATFORM=android-37.0
ANDROID_BUILD_TOOLS=37.0.0

# The system image the headless emulator runs.
ANDROID_EMULATOR_API=36

# LTS NDK. Two spellings of the same release: the archive Google publishes is
# named after the first, the SDK manager installs the second.
#
# Deliberately behind the newest release. Google's own download page lists
# r27d as the latest long-term version and r29 as the latest stable one, and
# they are different lines: r29 has no support window of its own. Of what r29
# changes, the only part that touches this project is the removal of
# llvm-lipo, a tool for macOS frameworks that nothing here builds.
NDK_RELEASE=r27d
NDK_VERSION=27.3.13750724
# The archive the NDK image unpacks. Google publishes a SHA-1 for it in
# repository2-3.xml and nothing stronger; this value was taken from the
# archive whose SHA-1 matched that publication
# (22105e410cf29afcf163760cc95522b9fb981121), so what the image compiles the
# release with is fixed to one file rather than to whatever the URL serves.
NDK_SHA256=601246087a682d1944e1e16dd85bc6e49560fe8b6d61255be2829178c8ed15d9

# The command-line tools the SDK image installs everything else with. Pinned
# the same way, against the SHA-1 in repository2-1.xml
# (040d3996a65543d22ec4bf73e4c37aa37a8d4af4).
CMDLINE_TOOLS_RELEASE=15859902
CMDLINE_TOOLS_SHA256=4e4c464f145a7512b57d088ac6c278c03c9eea610886b35a5e0804e74eedf583

# Collects the licences of the crates the core links, so the list the
# application shows comes out of the dependency graph rather than out of
# somebody's memory. The digest is the one published beside the archive; the
# binary is taken rather than built because compiling it takes longer than
# everything else in this image put together.
CARGO_ABOUT_VERSION=0.9.1
CARGO_ABOUT_SHA256=c0e7dc6f5d74b0beec5c0053d39ab24514c717d19acd91886907a22457ea9e98

# What Gradle and the Kotlin compiler run on, in the image and in CI alike.
# The newest long-term release: Temurin supports it until 2031-09-30, and
# Gradle runs on it from 9.1.0 onwards.
JDK_VERSION=25

# Only used to generate the wrapper the first time; the build itself runs the
# wrapper the project commits. The digest is the one Gradle publishes beside
# the archive, and the same value stands in gradle-wrapper.properties.
GRADLE_VERSION=9.6.1
GRADLE_SHA256=9c0f7faeeb306cb14e4279a3e084ca6b596894089a0638e68a07c945a32c9e14
