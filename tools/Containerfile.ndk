# Cross-compilation environment for the Rust core.
#
# The toolchain lives in the container, never on the host: an NDK plus three
# Rust targets is around 700 MB of build-only tooling that nothing else needs.
#
# Built by the scripts in this directory, which pass the versions from
# tools/versions.env. NDK_RELEASE has no default on purpose: a build that
# does not supply it fails here rather than producing an image pinned to
# something nobody wrote down.
# Pinned by digest as well as by tag: the tag moves, and the compiler that
# builds a released APK should not change underfoot. Dependabot watches the
# digest and opens a pull request when the tag moves on.
FROM docker.io/library/rust:1.98-trixie@sha256:620dbcd124499c59e2406d3741574b5c5838cf9eb9656f0c3a03948f79b02959

ARG NDK_RELEASE
ARG NDK_SHA256
ARG CARGO_NDK_VERSION
ARG CARGO_ABOUT_VERSION
ARG CARGO_ABOUT_SHA256
ARG CARGO_LLVM_COV_VERSION
ARG CARGO_LLVM_COV_SHA256

# cmake, make and perl are what the vendored builds need: libgit2 is built
# with cmake, OpenSSL configures itself with perl. They are build-only, which
# is exactly why they live here and not on the host.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        unzip curl ca-certificates cmake make perl \
    && rm -rf /var/lib/apt/lists/*

# The digest is checked before anything is unpacked: this archive is the
# compiler the released native code is built with, and TLS to dl.google.com
# only says who served it.
RUN curl -fsSL -o /tmp/ndk.zip \
        "https://dl.google.com/android/repository/android-ndk-${NDK_RELEASE}-linux.zip" \
    && echo "${NDK_SHA256}  /tmp/ndk.zip" | sha256sum -c - \
    && unzip -q /tmp/ndk.zip -d /opt \
    && rm /tmp/ndk.zip

ENV ANDROID_NDK_HOME=/opt/android-ndk-${NDK_RELEASE}
ENV ANDROID_NDK_ROOT=/opt/android-ndk-${NDK_RELEASE}

# arm64-v8a is what nearly every device runs; armeabi-v7a covers older ones
# and x86_64 the emulator.
RUN rustup target add aarch64-linux-android armv7-linux-androideabi x86_64-linux-android
# Named with a version, like everything else installed here: --locked
# fixes the dependencies of whichever release is chosen, not which
# release that is.
RUN cargo install "cargo-ndk@${CARGO_NDK_VERSION}" --locked

# The base image ships the minimal profile, so the two components CI fails on
# are missing — tools/check-core.sh runs them here. llvm-tools carries the
# profile reader coverage is computed with, and it has to be the one built
# alongside this compiler: a reader from another release does not understand
# the profiles this one writes.
RUN rustup component add rustfmt clippy llvm-tools-preview

# The licence collector, as the published binary rather than as a build from
# source: it pulls in a few hundred crates of its own and the image is already
# large. Same rule as the NDK above — the digest is checked before anything is
# unpacked, since TLS to github.com only says who served the file.
RUN curl -fsSL -o /tmp/about.tar.gz \
        "https://github.com/EmbarkStudios/cargo-about/releases/download/${CARGO_ABOUT_VERSION}/cargo-about-${CARGO_ABOUT_VERSION}-x86_64-unknown-linux-musl.tar.gz" \
    && echo "${CARGO_ABOUT_SHA256}  /tmp/about.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/about.tar.gz -C /tmp \
    && install -m 0755 \
        "/tmp/cargo-about-${CARGO_ABOUT_VERSION}-x86_64-unknown-linux-musl/cargo-about" \
        /usr/local/bin/cargo-about \
    && rm -rf /tmp/about.tar.gz "/tmp/cargo-about-${CARGO_ABOUT_VERSION}-x86_64-unknown-linux-musl"

# The coverage runner, as a binary for the same reason. The archive holds the
# executable and nothing else, so it is unpacked straight into the path.
RUN curl -fsSL -o /tmp/llvm-cov.tar.gz \
        "https://github.com/taiki-e/cargo-llvm-cov/releases/download/v${CARGO_LLVM_COV_VERSION}/cargo-llvm-cov-x86_64-unknown-linux-musl.tar.gz" \
    && echo "${CARGO_LLVM_COV_SHA256}  /tmp/llvm-cov.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/llvm-cov.tar.gz -C /usr/local/bin cargo-llvm-cov \
    && chmod 0755 /usr/local/bin/cargo-llvm-cov \
    && rm /tmp/llvm-cov.tar.gz

WORKDIR /src
