# Cross-compilation environment for the Rust core.
#
# The toolchain lives in the container, never on the host: an NDK plus three
# Rust targets is around 700 MB of build-only tooling that nothing else needs.
#
# Built by the scripts in this directory, which pass the versions from
# tools/versions.env. NDK_RELEASE has no default on purpose: a build that
# does not supply it fails here rather than producing an image pinned to
# something nobody wrote down.
# Pinned by digest as well as by tag: the tag moves, and the compiler that
# builds a released APK should not change underfoot. Dependabot watches the
# digest and opens a pull request when the tag moves on.
FROM docker.io/library/rust:1.97-trixie@sha256:1bcff4befb740599103a2c7cb51058e14479b2e35e3a34a3f0dc4ede09927488

ARG NDK_RELEASE
ARG NDK_SHA256

# cmake, make and perl are what the vendored builds need: libgit2 is built
# with cmake, OpenSSL configures itself with perl. They are build-only, which
# is exactly why they live here and not on the host.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        unzip curl ca-certificates cmake make perl \
    && rm -rf /var/lib/apt/lists/*

# The digest is checked before anything is unpacked: this archive is the
# compiler the released native code is built with, and TLS to dl.google.com
# only says who served it.
RUN curl -fsSL -o /tmp/ndk.zip \
        "https://dl.google.com/android/repository/android-ndk-${NDK_RELEASE}-linux.zip" \
    && echo "${NDK_SHA256}  /tmp/ndk.zip" | sha256sum -c - \
    && unzip -q /tmp/ndk.zip -d /opt \
    && rm /tmp/ndk.zip

ENV ANDROID_NDK_HOME=/opt/android-ndk-${NDK_RELEASE}
ENV ANDROID_NDK_ROOT=/opt/android-ndk-${NDK_RELEASE}

# arm64-v8a is what nearly every device runs; armeabi-v7a covers older ones
# and x86_64 the emulator.
RUN rustup target add aarch64-linux-android armv7-linux-androideabi x86_64-linux-android
RUN cargo install cargo-ndk --locked

# The base image ships the minimal profile, so the two components CI fails on
# are missing — tools/check-core.sh runs them here.
RUN rustup component add rustfmt clippy

WORKDIR /src
