<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Fetching the notes repository. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Reading a notes directory the user keeps on the shared storage. The
        core clones and walks it by path — libgit2 and std::fs cannot open a
        document tree from the system picker — and from Android 11 the only
        access that reaches an arbitrary path is this one. Not needed for the
        directory inside the application's own storage, which is where the
        notes live until another one is chosen.
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <application
        android:name=".MarkdownOrgApp"
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.MarkdownOrg">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MarkdownOrg">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
