<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Fetching the notes repository. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Reading a notes directory the user keeps on the shared storage. The
        core clones and walks it by path — libgit2 and std::fs cannot open a
        document tree from the system picker — and from Android 11 the only
        access that reaches an arbitrary path is this one. Not needed for the
        directory inside the application's own storage, which is where the
        notes live until another one is chosen.
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!--
        Telling the reader what is coming. All three are asked for by the
        reminders and by nothing else, and none of them is held until the
        reader switches reminders on.

        POST_NOTIFICATIONS is asked at runtime from Android 13. Without
        SCHEDULE_EXACT_ALARM the platform still delivers, within an hour of the
        time asked for, which the settings screen says where the switch is;
        USE_EXACT_ALARM, which needs no asking, is deliberately not declared,
        as the store policy limits it to alarm and calendar applications.
        RECEIVE_BOOT_COMPLETED is what lets the plan be made again after a
        restart: alarms do not survive one.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        Closing an entry from the drawer. A broadcast receiver has nine
        seconds and is killed with the process if it overstays, while a write
        reads the agenda, edits the note and commits it; a short service
        carries that instead. The short type needs no permission of its own,
        and the platform allows such a service to be started in answer to a
        notification the reader has just pressed.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application
        android:name=".MarkdownOrgApp"
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.MarkdownOrg">

        <!--
            Hands one note to whichever editor the user prefers. A file:// URI
            is refused by the platform outright, so the note travels as a
            content:// URI granted for the one launch, and the reading
            application needs no storage permission of its own.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.notes"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/note_paths" />
        </provider>

        <!--
            An alarm coming due. Not exported: the only sender is this
            application's own alarm, which the platform delivers on its behalf.
        -->
        <receiver
            android:name=".ReminderReceiver"
            android:exported="false" />

        <!--
            The occasions on which the plan is gone or about to be wrong. All
            five are broadcasts of the system, which reach a receiver that is
            not exported.
        -->
        <receiver
            android:name=".ReminderRestartReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action
                    android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!--
            The buttons a reminder carries. Not exported: the only sender is
            the notification this application raised.
        -->
        <receiver
            android:name=".ReminderActionReceiver"
            android:exported="false" />

        <service
            android:name=".ReminderCompletionService"
            android:exported="false"
            android:foregroundServiceType="shortService" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MarkdownOrg">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
