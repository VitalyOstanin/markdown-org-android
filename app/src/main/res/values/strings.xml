<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The name of the project, which reads the same in every language. -->
    <string name="app_name" translatable="false">markdown-org</string>
    <string name="agenda_failed">The agenda could not be built</string>
    <string name="agenda_empty">Nothing scheduled</string>

    <string name="agenda_layout_time">Time layout</string>
    <string name="agenda_layout_list">List layout</string>
    <string name="agenda_now">Current time</string>

    <!--
      The overdue entries stand in bands rather than in one group: what each
      of them asks for differs, and so does what is done about it.
    -->
    <string name="agenda_section_overdue_repeat">Missed repeats</string>
    <string name="agenda_section_overdue_recent">Overdue this week</string>
    <string name="agenda_section_overdue_earlier">Overdue earlier</string>
    <string name="agenda_section_overdue_long">Overdue long ago</string>
    <!-- Spoken for the heading that folds a group; %1$s is its name. -->
    <string name="agenda_section_expand">Show group %1$s</string>
    <string name="agenda_section_collapse">Hide group %1$s</string>
    <string name="agenda_section_timed">Scheduled today</string>
    <string name="agenda_section_untimed">Untimed and ahead</string>
    <!-- Start and end of a collapsed empty stretch on the hour axis. -->
    <string name="agenda_free_between">free %1$s — %2$s</string>

    <string name="sync_now">Sync now</string>
    <string name="sync_running">Syncing…</string>
    <string name="sync_cloned">Notes cloned</string>
    <string name="sync_updated">Notes updated</string>
    <string name="sync_already_current">Already up to date</string>
    <string name="sync_pushed">Edits sent to the server</string>
    <!-- Branch, then the summary of the commit at its tip. -->
    <string name="sync_checkout">%1$s · %2$s</string>
    <!-- Date and time of the last successful sync, written by the locale. -->
    <string name="sync_last_synced">synced %1$s</string>
    <string name="sync_failed_auth">The server rejected the token</string>
    <string name="sync_failed_network">The server could not be reached</string>
    <string name="sync_failed_diverged">Local commits differ from the remote</string>
    <string name="sync_failed_dirty">Uncommitted changes would be overwritten</string>
    <string name="sync_failed_address">The address cannot be used; nothing was sent</string>
    <string name="sync_failed_rejected">The server would not take the edits</string>
    <string name="sync_failed_repository">Sync failed</string>
    <!-- Under the diverged wording; the branch that moved on both sides. -->
    <string name="sync_diverged_detail">%1$s and origin/%1$s have both moved; this application does not merge</string>
    <!-- Under the rejected wording; the branch the server refused. Nothing was
         lost: the edits are still on the device. -->
    <string name="sync_rejected_detail">origin/%1$s holds commits this device does not; sync again to take them first</string>
    <string name="sync_status_unreadable">The checkout could not be read; it was left as it is</string>

    <string name="settings_title">Notes repository</string>
    <string name="settings_hint">The repository is cloned into the notes directory below. Syncing takes what the server has and then hands it what was changed here; neither side is ever merged or rewritten.</string>
    <string name="settings_url">Repository URL</string>
    <string name="settings_branch">Branch</string>
    <string name="settings_branch_default">the remote default</string>
    <string name="settings_token">Access token</string>
    <string name="settings_token_kept">saved; leave blank to keep it</string>
    <string name="settings_token_none">needed for a private repository</string>
    <string name="settings_token_drop">Forget the saved token</string>
    <string name="settings_notes">Notes directory</string>
    <string name="settings_notes_default">empty: the application\'s own storage</string>
    <string name="settings_notes_relative">Enter an absolute path, starting with /</string>
    <string name="settings_notes_not_dir">That path is a file, not a directory</string>
    <string name="settings_notes_denied">A directory outside the application\'s storage needs access to all files</string>
    <string name="settings_notes_grant">Grant access to all files</string>
    <string name="settings_notes_pick">Choose a directory</string>
    <string name="settings_notes_failed">The notes directory could not be used; the previous one was kept</string>
    <string name="settings_url_empty">Enter the address of the repository</string>
    <string name="settings_url_scheme">Only https:// and a local path are supported</string>
    <string name="settings_url_incomplete">The address names no repository</string>
    <string name="settings_save">Save</string>
    <string name="settings_cancel">Cancel</string>
    <string name="settings_licences">Licences</string>
    <!-- Which build this is: the version, the number that orders the builds
         for Android, and the commit it was made from. -->
    <string name="settings_version">Version %1$s (%2$d), commit %3$s</string>
    <string name="settings_crash">The previous run stopped unexpectedly</string>
    <string name="settings_crash_forget">Forget it</string>

    <string name="licences_title">Licences</string>
    <string name="licences_close">Back</string>
    <string name="licences_unavailable">This build carries no licence list. It is written by tools/licenses.sh and by the build itself; a build that skipped both has nothing to show here.</string>

    <string name="agenda_task_actions">Task actions</string>
    <!--
      What a long press on a row says. The heading comes first, in full, since
      the row itself shows only as much of it as fits; the lines below are the
      legend for the glyph and the priority badge, worded as the VS Code
      extension words them so the two clients read alike.
    -->
    <string name="tooltip_cancelled">Cancelled</string>
    <string name="tooltip_done">Done</string>
    <string name="tooltip_deadline">Has a deadline</string>
    <!-- %1$s is the date, with the time of day when the task states one. -->
    <string name="tooltip_deadline_at">Deadline: %1$s</string>
    <string name="tooltip_scheduled">Scheduled at a set time</string>
    <string name="tooltip_scheduled_at">Scheduled: %1$s</string>
    <!-- %1$s is the repeater in brackets, or nothing when it is not stated. -->
    <string name="tooltip_repeating">Repeating%1$s</string>
    <!-- %2$s is the next occurrence the core resolved… -->
    <string name="tooltip_repeating_next">Repeating%1$s — next %2$s</string>
    <!-- …and here the date the task itself carries, which may be in the past. -->
    <string name="tooltip_repeating_on">Repeating%1$s — dated %2$s</string>
    <string name="tooltip_priority">Priority %1$s</string>
    <string name="tooltip_priority_highest">Priority %1$s (highest)</string>
    <string name="tooltip_priority_lowest">Priority %1$s (lowest)</string>
    <string name="action_complete">Done</string>
    <string name="action_complete_repeating">Done, move to next occurrence</string>
    <!-- Worded away from "cancel": in the sheet it writes CANCELLED into the
         note and commits, while "Cancel" on the settings form throws an edit
         away. Two opposite kinds of action must not share a word. -->
    <string name="action_cancel_task">Drop the task</string>
    <string name="action_reopen">Reopen</string>
    <string name="action_priority">Priority</string>
    <!-- The option that leaves the task without a priority cookie. -->
    <string name="action_priority_none">None</string>
    <string name="action_shift_back">A day earlier</string>
    <string name="action_shift_forward">A day later</string>

    <string name="edit_failed">The task could not be changed</string>
    <string name="edit_failed_stale">The file has changed; sync and try again</string>
    <string name="edit_failed_no_planning">The task has no date to move</string>
    <string name="edit_failed_unsupported">This repeater cannot be advanced here yet</string>
    <string name="edit_failed_missing">The file is no longer there</string>
    <string name="edit_failed_encoding">The file is not UTF-8; convert it and try again</string>
    <string name="edit_failed_unnamed">The file name is not UTF-8, so the task cannot be changed</string>
    <!-- The note was written; only the commit did not happen. Worded away
         from a failure: repeating the tap would edit an already edited file. -->
    <string name="edit_not_committed">Saved, but not committed; the next edit or sync will commit it</string>
    <string name="notes_reset_failed">The notes directory could not be emptied</string>

    <string name="agenda_truncated">The task limit was reached; the list is incomplete</string>
    <!-- Shown when a failure carries nothing readable of its own. -->
    <string name="agenda_failed_unknown">The reason is in the log</string>

    <!-- Under the dirty wording; how many files stand in the way. -->
    <plurals name="sync_dirty_detail">
        <item quantity="one">%d file changed since the last commit</item>
        <item quantity="other">%d files changed since the last commit</item>
    </plurals>

    <plurals name="sync_pushed_detail">
        <item quantity="one">%d commit handed over</item>
        <item quantity="other">%d commits handed over</item>
    </plurals>

    <!-- In the header, while edits made here are still only here. -->
    <plurals name="sync_unpushed">
        <item quantity="one">%d commit not sent</item>
        <item quantity="other">%d commits not sent</item>
    </plurals>

    <!--
      Read under a heading that already says the entry is overdue, so the row
      counts the days and no more: the sentence took the width the heading
      needs and said what the heading had just said.
    -->
    <plurals name="agenda_days_overdue">
        <item quantity="one">%d day</item>
        <item quantity="other">%d days</item>
    </plurals>
    <!-- The same count for a screen reader, where no heading stands above it. -->
    <plurals name="agenda_days_overdue_spoken">
        <item quantity="one">%d day late</item>
        <item quantity="other">%d days late</item>
    </plurals>
    <plurals name="agenda_days_ahead">
        <item quantity="one">in %d day</item>
        <item quantity="other">in %d days</item>
    </plurals>

    <!-- What the walk behind the agenda skipped, and why. -->
    <plurals name="agenda_skipped_encoding">
        <item quantity="one">%d file was skipped: it is not UTF-8</item>
        <item quantity="other">%d files were skipped: they are not UTF-8</item>
    </plurals>
    <plurals name="agenda_unreadable">
        <item quantity="one">%d file could not be read</item>
        <item quantity="other">%d files could not be read</item>
    </plurals>
    <plurals name="agenda_skipped_size">
        <item quantity="one">%d file was skipped: too large</item>
        <item quantity="other">%d files were skipped: too large</item>
    </plurals>
    <plurals name="agenda_unnamed_paths">
        <item quantity="one">%d file has a name that is not UTF-8; its tasks cannot be changed</item>
        <item quantity="other">%d files have names that are not UTF-8; their tasks cannot be changed</item>
    </plurals>
</resources>
