<?xml version="1.0" encoding="utf-8"?>
<!--
    The languages the application ships, so Android 13 and later list it under
    the per-app language preference. Without this the interface follows the
    system language and cannot be set apart from it — a Russian phone gets a
    Russian agenda and nothing else.

    Kept by hand rather than generated by `generateLocaleConfig`, which reads
    the same `values-*` directories: the list is two lines long, and a build
    that generates it needs `res/resources.properties` to declare which
    language `values/` itself is written in. TranslationsTest holds this file
    to the directories that exist.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="ru" />
</locale-config>
